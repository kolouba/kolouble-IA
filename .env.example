# ── Base de données ────────────────────────────────────────────────────────────
# Local (SQLite, zéro configuration) : prisma/sqlite/schema.prisma
DATABASE_URL="file:./dev.db"

# Production (Postgres Supabase) : utiliser prisma/postgres/schema.prisma
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="remplacez-moi"
AUTH_TRUST_HOST="true"
# URL publique exacte en production (Vercel, Docker, domaine propre)
# AUTH_URL="https://apps.exemple.ci"

# Connexion Google (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Connexion Facebook (optionnel)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Connexion GitHub (optionnel) — scope minimal : read:user user:email
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# URL publique (utilisée dans les docs et l'aperçu)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="deepseek-coder:latest"
# Modèles proposés dans l'interface (séparés par des virgules)
OLLAMA_MODELS="deepseek-coder:latest,qwen2.5-coder:7b,qwen2.5-coder:14b"
OLLAMA_TIMEOUT_MS="240000"

# ── Fournisseurs IA (optionnels) ─────────────────────────────────────────────
# Fournisseur par défaut : ollama | openai | anthropic | google | mistral | deepseek
AI_PROVIDER="ollama"
AI_MODEL=""
# Une clé ne doit jamais être commitée. Renseignez-la uniquement dans l'environnement local ou l'hébergeur.
OPENAI_API_KEY=""
OPENAI_MODELS="gpt-4o-mini,gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODELS="claude-3-5-sonnet-latest"
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODELS="gemini-2.0-flash"
MISTRAL_API_KEY=""
MISTRAL_MODELS="mistral-large-latest"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODELS="deepseek-chat"

# ── Imports Figma / compilation Flutter ──────────────────────────────────────
# Jeton Figma personnel en lecture seule (ne jamais commité)
FIGMA_TOKEN=""
# Active la compilation Flutter locale (`flutter build web`, APK debug)
BUILD_ENABLED="false"
FLUTTER_BIN="flutter"
BUILD_TIMEOUT_MS="600000"

# ── Workspace / sandbox ───────────────────────────────────────────────────────
# Chemin absolu ou relatif. Sur Vercel, la base de données reste la source de vérité.
WORKSPACE_ROOT="./workspace"
# Serveur de preview autonome durci (optionnel, self-host)
NEXT_PUBLIC_PREVIEW_SERVER_URL=""

# ── Limites ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES="512000"

# ── Auto-hébergement Docker + Caddy (optionnel) ───────────────────────────────
# Domaine public et e-mail Let's Encrypt pour `docker compose --profile proxy`
# SITE_DOMAIN="apps.exemple.ci"
# ACME_EMAIL="admin@exemple.ci"
