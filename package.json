{
  "name": "kolouble-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Studio local de génération d'applications Flutter/Supabase piloté par Ollama",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "build:vercel": "npm run pg:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema prisma/sqlite/schema.prisma",
    "pg:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "pg:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/sqlite/schema.prisma",
    "db:studio": "prisma studio --schema prisma/sqlite/schema.prisma",
    "db:push": "prisma db push --schema prisma/sqlite/schema.prisma",
    "sandbox": "node sandbox/preview-server.mjs",
    "postinstall": "prisma generate --schema prisma/sqlite/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
